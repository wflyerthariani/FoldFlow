# The only file you edit when reusing this in another repo or as another IBEX user.
# Nothing below should name a person; PROJECT (this repo's absolute path, set by lib.sh before
# this file is sourced) already varies per checkout, so paths built from it need no username.
GPU_HOST="glogin.ibex.kaust.edu.sa"
GPU_USER="$(id -un)"      # your IBEX username; defaults to whoever is running these scripts
ENTRY="main.nf"
PROFILE="singularity,slurm,ibex"   # profile for real runs (hpc/run.sh)
TEST_PROFILE="test"      # profile for stub runs (hpc/check.sh); should not request GPUs
RUN_SETTLE=20            # seconds hpc/run.sh watches a fresh submit, so an immediate failure is reported right away

INPUT_PDB="${INPUT_PDB:-$PROJECT/6px6.pdb}"   # the structure to design against; change per user/run
RUN_ARGS="--input_pdb '$INPUT_PDB'"           # extra nextflow args for hpc/run.sh and hpc/check.sh
