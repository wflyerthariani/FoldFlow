config {

    // "." so that `nf-test test` with no arguments discovers the per-module
    // tests under modules/local/**, not just the suites in tests/.
    testsDir "."
    workDir ".nf-test"
    configFile "tests/nextflow.config"
    libDir "tests/lib"
    profile ""

    // Never descend into pipeline outputs or nf-test's own scratch.
    ignore "work/**", ".nf-test/**", "results/**", "results_test/**", "hpc/**", ".git/**"

}
