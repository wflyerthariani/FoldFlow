/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args            = Additional arguments appended to command in module.
        ext.args2           = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3           = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix          = File name prefix for output files.
        ext.when            = Conditional execution of process
        publishDir.path     = Output directory path
        publishDir.mode     = Publishing mode (copy, symlink, etc.)
        publishDir.saveAs   = Filter which files to publish
----------------------------------------------------------------------------------------
*/

process {

    // Default publishDir configuration for all processes
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // -----------------------------------------------------------------------
    // RFDIFFUSION — results/rfdiffusion/
    //   outputs: RFD_design_*.pdb (structure files)
    //            RFD_design_*.trb (trajectory files)
    // -----------------------------------------------------------------------
    withName: 'RFDIFFUSION' {
        label = 'process_gpu'
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/rfdiffusion" },
                mode: params.publish_dir_mode,
                pattern: "*.pdb",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/${meta.id}/rfdiffusion" },
                mode: params.publish_dir_mode,
                pattern: "*.trb",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
        ext.args = ''
    }

    // -----------------------------------------------------------------------
    // BOLTZGEN — results/boltzgen/
    //   outputs: BG_design_*.pdb (structure files)
    // -----------------------------------------------------------------------
    withName: 'BOLTZGEN' {
        label = 'process_gpu'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/boltzgen" },
            mode: params.publish_dir_mode,
            pattern: "*.pdb",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = ''
    }

    // -----------------------------------------------------------------------
    // PROTEINMPNN — results/proteinmpnn/
    //   outputs: MPNN_*.fa (sequence files)
    // -----------------------------------------------------------------------
    withName: 'PROTEINMPNN' {
        label = 'process_gpu'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/proteinmpnn" },
            mode: params.publish_dir_mode,
            pattern: "*.fa",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = ''
    }

    // -----------------------------------------------------------------------
    // LIGANDMPNN — results/ligandmpnn/
    //   outputs: {lineage}_mpnn_*.fa (sequence files)
    // -----------------------------------------------------------------------
    withName: 'LIGANDMPNN' {
        label = 'process_gpu'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/ligandmpnn" },
            mode: params.publish_dir_mode,
            pattern: "*.fa",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = ''
    }

    // -----------------------------------------------------------------------
    // ALPHAFOLD — results/alphafold/
    //   outputs: AF2_*.pdb (predicted structures)
    //            AF2_*_scores.json (confidence scores)
    // -----------------------------------------------------------------------
    withName: 'ALPHAFOLD' {
        label = 'process_gpu'
        cpus   = 8
        memory = 64.GB
        time   = 8.h
        errorStrategy = 'retry'
        maxRetries = 2
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/alphafold" },
                mode: params.publish_dir_mode,
                pattern: "*.pdb",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/${meta.id}/alphafold" },
                mode: params.publish_dir_mode,
                pattern: "*_scores.json",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
        ext.args = ''
    }
}
