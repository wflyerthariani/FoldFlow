/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for KAUST Ibex HPC cluster
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for running the pipeline on the Ibex SLURM cluster using Singularity.
----------------------------------------------------------------------------------------
*/

process {
    executor       = 'slurm'
    cpus           = 4
    memory         = '64.GB'
    time           = '1.h'
    clusterOptions = '--ntasks=1 --gres=gpu:1 --mail-user=arman.thariani@gmail.com --mail-type=ALL'

    // BoltzGen requires CUDA compute capability >= 7.0 (Volta+).
    // The default gpu:1 can land on Pascal (CC 6.1) which lacks the required kernels.
    withName: 'BOLTZGEN' {
        clusterOptions = '--ntasks=1 --gres=gpu:v100:1 --mail-user=arman.thariani@gmail.com --mail-type=ALL'
    }
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = '--nv'
}

params {
    // Can be overridden at runtime with: --alphafold_data_dir <path>
    alphafold_data_dir = '/ibex/reference/KSL/alphafold/2.3.1/'
}
