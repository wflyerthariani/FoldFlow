/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data for minimal test
    output_prefix = 'test_design'

    // Every output count is pinned here rather than read from configs/*.yaml, so the
    // test profile stays deterministic no matter how those files are edited.
    // 2 designs x 2 backbone tools = 4 backbones
    // 4 backbones x (1 + 2) sequences = 12 sequences
    // 12 sequences x 2 predictors = 24 predictions
    rfdiff_num_designs         = 2
    boltzgen_num_designs       = 2
    mpnn_num_sequences         = 1
    ligandmpnn_num_sequences   = 2
    alphafold_num_predictions  = 1
    alphafold3_num_predictions = 1
    
    // Test-specific settings
    outdir = './results_test'
}
