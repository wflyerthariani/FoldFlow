/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running on SLURM
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for running the pipeline on a SLURM cluster with GPU support
----------------------------------------------------------------------------------------
*/

process {
    executor = 'slurm'
    queue = 'batch'
    
    // Default resources
    cpus = 8
    memory = '64 GB'
    time = '1h'
    
    // GPU processes
    withLabel: 'process_gpu' {
        clusterOptions = '--gres=gpu:1'
        cpus = 8
        memory = '64 GB'
        time = '8h'
    }
    
    // High memory processes
    withLabel: 'process_high_memory' {
        memory = '128 GB'
        time = '16h'
    }
}

singularity {
    enabled = true
    autoMounts = true
}

executor {
    $slurm {
        exitReadTimeout = '60 min'
        queueSize = 50
        submitRateLimit = '10 sec'
    }
}

// Runtime container paths and model/data directories are configured in:
//   - configs/RFdiffusion.yaml
//   - configs/MPNN.yaml
//   - configs/AlphaFold.yaml
