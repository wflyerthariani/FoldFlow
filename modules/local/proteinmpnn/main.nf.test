nextflow_process {

    name "Test Process PROTEINMPNN"
    script "modules/local/proteinmpnn/main.nf"
    process "PROTEINMPNN"

    tag "modules"
    tag "proteinmpnn"
    tag "sequence"

    // -------------------------------------------------------------------------
    // STUB TESTS
    // -------------------------------------------------------------------------

    test("stub - emits mpnn_num_sequences FASTAs carrying the backbone lineage") {
        tag "stub"
        options "-stub-run"

        when {
            params {
                mpnn_num_sequences = 2
            }
            process {
                """
                input[0] = [
                    [ id: 'test_design', lineage: 'rfdiffusion_1' ],
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb"),
                    file("${projectDir}/tests/data/test.fixed_regions")
                ]
                """
            }
        }

        then {
            def names = process.out.sequences[0][1].collect { path(it).fileName.toString() } as Set
            assertAll(
                { assert process.success },
                { assert process.out.sequences.size() == 1 },
                { assert process.out.versions.size() == 1 },

                { assert names.size() == 2 },
                // The sequence index and the tool tag both live in the filename; the
                // validation stage reads the lineage back out of it with a regex.
                { assert names.contains('rfdiffusion_1_mpnn_1_proteinmpnn.fa') },
                { assert names.contains('rfdiffusion_1_mpnn_2_proteinmpnn.fa') },

                { assert path(process.out.versions[0]).text.contains('PROTEINMPNN') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("stub - sequence count follows mpnn_num_sequences") {
        tag "stub"
        options "-stub-run"

        when {
            params {
                mpnn_num_sequences = 4
            }
            process {
                """
                input[0] = [
                    [ id: 'test_design', lineage: 'boltzgen_2' ],
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb"),
                    file("${projectDir}/tests/data/test.fixed_regions")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.sequences[0][1].size() == 4 },
                // Works downstream of either backbone tool, not just RFdiffusion.
                { assert process.out.sequences[0][1].every {
                        path(it).fileName.toString().startsWith('boltzgen_2_mpnn_') } }
            )
        }
    }

    test("stub - falls back to a design_idx lineage when meta has none") {
        tag "stub"
        options "-stub-run"

        when {
            params {
                mpnn_num_sequences = 1
            }
            process {
                """
                input[0] = [
                    [ id: 'test_design', design_idx: 2 ],
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb"),
                    file("${projectDir}/tests/data/test.fixed_regions")
                ]
                """
            }
        }

        then {
            // A single match is emitted as a scalar path, not a one-element list.
            def seqs = process.out.sequences[0][1]
            def seqList = seqs instanceof List ? seqs : [seqs]
            assertAll(
                { assert process.success },
                { assert seqList.size() == 1 },
                // design_idx is 0-based, the lineage is 1-based.
                { assert path(seqList[0]).fileName.toString() ==
                        'rfdiffusion_3_mpnn_1_proteinmpnn.fa' }
            )
        }
    }

    test("stub - an empty sidecar is accepted, as BoltzGen produces one") {
        tag "stub"
        options "-stub-run"

        when {
            params {
                mpnn_num_sequences = 1
            }
            process {
                """
                input[0] = [
                    [ id: 'test_design', lineage: 'boltzgen_1' ],
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb"),
                    file("${projectDir}/tests/data/empty.fixed_regions")
                ]
                """
            }
        }

        then {
            def seqs = process.out.sequences[0][1]
            def seqList = seqs instanceof List ? seqs : [seqs]
            assertAll(
                { assert process.success },
                { assert seqList.size() == 1 }
            )
        }
    }

    // -------------------------------------------------------------------------
    // FULL TEST - needs the container and a GPU.  nf-test test --tag gpu
    // -------------------------------------------------------------------------

    test("proteinmpnn designs sequences for a backbone") {
        tag "gpu"
        tag "full"

        when {
            params {
                mpnn_num_sequences = 2
            }
            process {
                """
                input[0] = [
                    [ id: 'test_design', lineage: 'rfdiffusion_1' ],
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb"),
                    file("${projectDir}/tests/data/test.fixed_regions")
                ]
                """
            }
        }

        then {
            def fastas = process.out.sequences[0][1].collect { path(it) }
            assertAll(
                { assert process.success },
                { assert fastas.size() == 2 },
                // Each split file holds exactly one record: MPNN's echoed input
                // sequence must have been dropped by split_mpnn_fastas.py.
                { assert fastas.every { it.text.count('>') == 1 } },
                { assert fastas.every { it.text.readLines()[1] ==~ /^[A-Z\/:]+$/ } }
            )
        }
    }
}
