nextflow_process {

    name "Test Process PROTEINMPNN"
    script "modules/local/proteinmpnn/main.nf"
    process "PROTEINMPNN"

    test("proteinmpnn sequence design with structure and trajectory") {
        tag "fast"
        tag "gpu"
        options "-dump-hashes"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_structure' ],
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb"),
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.trb")
                ]
                """
            }
        }

        then {
            DebugUtils.printTree(process.out)

            assert process.success

            // Output FASTA sequence files exist
            assert process.out.sequences.size() == 1
            def (meta, fastaPath) = process.out.sequences[0]
            assert meta.id == 'test_structure'
            
            // Check that FASTA files were generated
            def fastaFiles = fastaPath instanceof List ? fastaPath : [fastaPath]
            assert fastaFiles.size() > 0
            fastaFiles.each { fasta ->
                def fastaFile = path(fasta)
                assert fastaFile.exists()
                assert fastaFile.fileName.toString().endsWith('.fa')
                
                // Verify FASTA format
                def content = fastaFile.text
                assert content.contains('>')
            }

            // Versions output is present
            assert process.out.versions.size() == 1
            def versionsYml = path(process.out.versions[0])
            assert versionsYml.text.contains('PROTEINMPNN')
            assert versionsYml.text.contains('proteinmpnn')

            assert snapshot(process.out).match()
        }

    }

    test("proteinmpnn sequence design with structure only") {
        tag "fast"
        tag "gpu"
        options "-dump-hashes"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_structure_no_trb' ],
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb"),
                    []
                ]
                """
            }
        }

        then {
            DebugUtils.printTree(process.out)

            assert process.success

            // Output FASTA sequence files exist
            assert process.out.sequences.size() == 1
            def (meta, fastaPath) = process.out.sequences[0]
            assert meta.id == 'test_structure_no_trb'

            // Versions output is present
            assert process.out.versions.size() == 1

            assert snapshot(process.out).match()
        }

    }

    // =========================================================================
    // STUB TESTS
    // =========================================================================

    test("stub | proteinmpnn sequence design with structure and trajectory") {
        tag "stub"
        tag "fast"
        options "-stub-run -dump-hashes"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_structure' ],
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb"),
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.trb")
                ]
                """
            }
        }

        then {
            DebugUtils.printTree(process.out)
            assert process.success

            // Output FASTA sequence files exist
            assert process.out.sequences.size() == 1
            def (meta, fastaPath) = process.out.sequences[0]
            assert meta.id == 'test_structure'
            
            // Check that stub FASTA files were generated (default num_sequences = 2)
            def fastaFiles = fastaPath instanceof List ? fastaPath : [fastaPath]
            assert fastaFiles.size() >= 1
            
            // Verify stub files have .fa extension
            fastaFiles.each { fasta ->
                def fastaFile = path(fasta)
                assert fastaFile.fileName.toString().endsWith('.fa')
            }

            // Versions output is present
            assert process.out.versions.size() == 1

            assert snapshot(process.out).match()
        }

    }
}
