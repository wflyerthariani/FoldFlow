nextflow_process {

    name "Test Process RFDIFFUSION"
    script "modules/local/rfdiffusion/main.nf"
    process "RFDIFFUSION"

    tag "modules"
    tag "rfdiffusion"
    tag "backbone"

    // -------------------------------------------------------------------------
    // STUB TESTS - no GPU, no container, no weights. These run in seconds and
    // cover the contract: output cardinality, the lineage carried in meta, and
    // the filenames every downstream stage depends on.
    // -------------------------------------------------------------------------

    test("stub - emits one backbone and one sidecar per design index") {
        tag "stub"
        options "-stub-run"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_design' ],
                    0,
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },

                // One structure and exactly one matching sidecar: the sequence stage
                // joins them by meta, so a missing sidecar silently drops the design.
                { assert process.out.structures.size() == 1 },
                { assert process.out.fixed_regions.size() == 1 },
                { assert process.out.versions.size() == 1 },

                { assert process.out.structures[0][0].id == 'test_design' },

                // Default lineage is derived from the design index, 1-based.
                { assert path(process.out.structures[0][1]).fileName.toString() ==
                        'test_design_RFD_0_rfdiffusion_1_rfdiffusion.pdb' },
                { assert path(process.out.fixed_regions[0][1]).fileName.toString() ==
                        'test_design_RFD_0_rfdiffusion_1_rfdiffusion.fixed_regions' },

                { assert path(process.out.versions[0]).text.contains('RFDIFFUSION') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("stub - a lineage already on meta is preserved, not recomputed") {
        tag "stub"
        options "-stub-run"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_design', lineage: 'rfdiffusion_7' ],
                    6,
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // The workflow stamps meta.lineage before branching; the module must
                // use it verbatim so outputs stay traceable to the right design.
                { assert path(process.out.structures[0][1]).fileName.toString() ==
                        'test_design_RFD_6_rfdiffusion_7_rfdiffusion.pdb' }
            )
        }
    }

    test("stub - different design indices produce distinct filenames") {
        tag "stub"
        options "-stub-run"

        when {
            process {
                """
                input[0] = channel.of(
                    [ [ id: 'test_design' ], 0, file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb") ],
                    [ [ id: 'test_design' ], 1, file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb") ],
                    [ [ id: 'test_design' ], 2, file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb") ]
                )
                """
            }
        }

        then {
            def names = process.out.structures.collect { path(it[1]).fileName.toString() } as Set
            assertAll(
                { assert process.success },
                { assert process.out.structures.size() == 3 },
                // Three designs must not overwrite one another when published.
                { assert names.size() == 3 },
                { assert names.every { it.endsWith('_rfdiffusion.pdb') } }
            )
        }
    }

    // -------------------------------------------------------------------------
    // FULL TEST - needs the container, the RFdiffusion weights and a GPU.
    // Opt in with: nf-test test --tag gpu
    // -------------------------------------------------------------------------

    test("rfdiffusion generates a backbone from the input structure") {
        tag "gpu"
        tag "full"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_design' ],
                    0,
                    file("${projectDir}/6px6.pdb")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.structures.size() == 1 },
                { assert process.out.fixed_regions.size() == 1 },

                // A real backbone has ATOM records; an empty file would still have
                // passed the stub assertions above.
                { assert path(process.out.structures[0][1]).text.contains('ATOM') },
                { assert path(process.out.structures[0][1]).fileName.toString().endsWith('_rfdiffusion.pdb') },

                // The TRB is converted to the sidecar and deleted, so no .trb survives.
                { assert path(process.out.fixed_regions[0][1]).fileName.toString().endsWith('.fixed_regions') }
            )
        }
    }
}
