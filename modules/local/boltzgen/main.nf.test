nextflow_process {

    name "Test Process BOLTZGEN"
    script "modules/local/boltzgen/main.nf"
    process "BOLTZGEN"

    tag "modules"
    tag "boltzgen"
    tag "backbone"

    // -------------------------------------------------------------------------
    // STUB TESTS
    // -------------------------------------------------------------------------

    test("stub - emits one backbone and one sidecar per design index") {
        tag "stub"
        options "-stub-run"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_design' ],
                    0,
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.structures.size() == 1 },
                { assert process.out.fixed_regions.size() == 1 },
                { assert process.out.versions.size() == 1 },

                { assert process.out.structures[0][0].id == 'test_design' },
                { assert path(process.out.structures[0][1]).fileName.toString() ==
                        'test_design_BG0_0_boltzgen_1_boltzgen.pdb' },
                { assert path(process.out.fixed_regions[0][1]).fileName.toString() ==
                        'test_design_BG0_0_boltzgen_1_boltzgen.fixed_regions' },

                { assert path(process.out.versions[0]).text.contains('BOLTZGEN') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("stub - a lineage already on meta is preserved, not recomputed") {
        tag "stub"
        options "-stub-run"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_design', lineage: 'boltzgen_3' ],
                    2,
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.structures[0][1]).fileName.toString() ==
                        'test_design_BG2_0_boltzgen_3_boltzgen.pdb' }
            )
        }
    }

    test("stub - backbone names never collide with RFdiffusion's") {
        tag "stub"
        options "-stub-run"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_design' ],
                    0,
                    file("${projectDir}/modules/local/proteinmpnn/TESTDATA/test_structure.pdb")
                ]
                """
            }
        }

        then {
            def name = path(process.out.structures[0][1]).fileName.toString()
            assertAll(
                { assert process.success },
                // Both backbone tools publish into the same downstream channel, so the
                // tool tag in the filename is what keeps their outputs apart.
                { assert name.contains('_boltzgen') },
                { assert !name.contains('rfdiffusion') }
            )
        }
    }

    // -------------------------------------------------------------------------
    // FULL TEST - needs the container, BoltzGen weights and a GPU with
    // compute capability >= 7.0.  nf-test test --tag gpu
    // -------------------------------------------------------------------------

    test("boltzgen generates a backbone from the entity spec") {
        tag "gpu"
        tag "full"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_design' ],
                    0,
                    file("${projectDir}/6px6.pdb")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.structures.size() == 1 },

                // BoltzGen writes mmCIF; the module converts to PDB with gemmi, so a
                // successful run must leave real ATOM records behind.
                { assert path(process.out.structures[0][1]).text.contains('ATOM') },

                // BoltzGen has no fixed motif, so its sidecar is created but empty.
                { assert process.out.fixed_regions.size() == 1 },
                { assert path(process.out.fixed_regions[0][1]).text.trim() == '' }
            )
        }
    }
}
